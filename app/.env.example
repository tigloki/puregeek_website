# Copy to .env and fill in real values, or export these as real env vars
# before running server.py. Without these, submissions still save to
# submissions.db, but no notification email is sent.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password-or-real-password
MAIL_FROM=you@example.com
MAIL_TO=puregeek@puregeek.net
# Optional: a carrier email-to-SMS gateway address, sent alongside the email
# above via the same SMTP connection. E.g. T-Mobile: <10-digit-number>@tmomail.net
SMS_TO=
PORT=1212
